# WiFi Sense environment. Copy to .env (chmod 600). Never commit .env.
# Precedence: built-in defaults < config.yaml < this file / exported environment.

# auto = every link uses its configured source (rssi / esp32); sim = simulated room (development, demo).
WIFI_SOURCE=auto
# The host's WiFi interface for rssi links (a link in config.yaml may override it).
WIFI_INTERFACE=wlan0
# How often /proc/net/wireless is read (1-100 Hz).
WIFI_SAMPLE_HZ=10
# Tiny ICMP echo (or UDP) packets to the gateway, so fresh frames arrive between beacons.
WIFI_POKE=true
WIFI_POKE_HZ=10
WIFI_ESP32_BAUD=921600

# Detection. Scores are robust z-scores against the empty room; 1.0 in the UI = the threshold.
WIFI_WINDOW_SECONDS=3
WIFI_WARMUP_SECONDS=20
WIFI_MOTION_THRESHOLD=4
WIFI_PRESENCE_THRESHOLD=5
# Motion must stay above the threshold this long before an episode starts.
WIFI_TRIGGER_SECONDS=1
# The episode stays open this long after the last motion (people pause).
WIFI_HOLD_SECONDS=45
# Human likelihood (0-1) that must hold for WIFI_CONFIRM_SECONDS before an episode counts as "ember".
WIFI_HUMAN_THRESHOLD=0.6
WIFI_CONFIRM_SECONDS=2
# Baseline centres follow slow drift while the room is empty (time constant, seconds).
WIFI_ADAPT_SECONDS=600
# A level shift without movement keeps an episode open at most this long (then it is the new empty room).
WIFI_STATIC_MAX_SECONDS=600
WIFI_CALIBRATION_SECONDS=60

# Alarm: human = confirmed human motion only; any = every motion episode.
WIFI_ALARM_TRIGGER=human
# Exit delay after arming, to leave the room.
WIFI_ARM_DELAY_SECONDS=60
WIFI_ALARM_COOLDOWN_SECONDS=120

# Missing URL OR topic disables ntfy. Same variables as the camera stack: one topic for both.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
# Optional JSON POST on every alarm ({"type": "wifi_presence_alarm", "event": {...}}), e.g. to the camera stack.
WIFI_WEBHOOK_URL=

# Episode rows older than this are deleted (hourly).
WIFI_RETENTION_DAYS=30

WIFI_WEB_ENABLED=true
# Docker (host network): 127.0.0.1 = only the Pi itself; 0.0.0.0 = LAN and tailnet.
# No built-in authentication: do not expose this port to the public Internet.
WIFI_WEB_HOST=127.0.0.1
WIFI_WEB_PORT=8010
# Blank: ./data locally; Compose fixes it to /data.
WIFI_DATA_DIR=
LOG_LEVEL=INFO
TZ=Europe/Budapest
# Compose bind mount owner: Linux 'id -u' / 'id -g'.
APP_UID=1000
APP_GID=1000
